# TEIBAN AI assistant configuration  (template)
# ---------------------------------------------------------------------------
# Copy this file to ".env" (next to teiban.sif, or in the folder you run from)
# and fill in your own server. Then, in the tool's menu, choose
# "Ask the AI assistant" to ask in plain language.
#
# ".env" is git-ignored and is NOT bundled inside teiban.sif, so each user /
# machine sets its own endpoint. Do not commit your real .env.
#
# The endpoint must be OpenAI-compatible (e.g. a local vLLM or Ollama server
# exposing /v1/chat/completions).

# Base URL of your OpenAI-compatible server (note the /v1 suffix):
TEIBAN_AI_URL=http://YOUR-SERVER:8000/v1

# The model name your server serves:
TEIBAN_AI_MODEL=your-model-name

# API key -- leave blank for a local server that doesn't require one:
TEIBAN_AI_KEY=
